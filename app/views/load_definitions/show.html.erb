<%= content_for(:title) { @load_definition.name_in_database } %>
<% breadcrumb :load_definition, @pipeline, @load_definition %>

<%= content_for :heading do %>
  <h1><%= @load_definition.name %></h1>
<% end %>

<%= content_for :actions do %>
  <button type="button" class="btn btn-outline-danger" data-bs-toggle="modal" data-bs-target="#delete-modal">
    <i class="bi bi-trash" aria-hidden="true"></i> Delete
  </button>
<% end %>

<div class='card'>
  <div class='card-body'>
    <%= vertical_form_with model: [@pipeline, @harvest_definition, @load_definition] do |form| %>
      <%= render 'load_definitions/fields', form:, harvest_definition: @harvest_definition %>

      <div class='float-end mt-4'>
        <button type="submit" class="btn btn-primary">Update load definition</button>
      </div>
    <% end %>
  </div>
</div>

<% delete_path = pipeline_harvest_definition_load_definition_path(@pipeline, @harvest_definition, @load_definition) %>

<%= render layout: 'shared/delete_modal', locals: { path: delete_path } do %>
  <p>Are you sure you want to delete "<%= @load_definition.name %>"?</p>

  <p>The block will fall back to writing the way its kind implies until you give it another one.</p>
<% end %>

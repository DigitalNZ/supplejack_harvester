<%= content_for(:title) { automation_template.name } %>

<%= content_for :heading do %>
  <h1><%= automation_template.name %></h1>

  <%= render 'shared/description_editor', model: automation_template,
                                          url: automation_template_path(automation_template) %>

  <% if last_automation_run.present? %>
    <p class="mb-0">
      Last run on <strong><%= last_automation_run.created_at.strftime('%B %d, %Y at %H:%M') %></strong>
      to destination <strong><%= automation_template.destination.name %></strong>.
    </p>
  <% else %>
    <p class="mb-0">
      This template has never been run. Destination: <%= automation_template.destination.name %>.
    </p>
  <% end %>

  <% if ENV['JOB_PRIORITIES'].present? %>
    <p class="mb-0">
      <strong><%= job_priority_label(automation_template) %></strong>
    </p>
  <% end %>
<% end %>

<%= content_for :actions do %>
  <%= link_to 'Edit', edit_automation_template_path(automation_template),
              class: 'btn btn-outline-primary' %>

  <%= link_to '+ Add new schedule', new_schedule_path, class: 'btn btn-primary' %>

  <button type="button" class="btn btn-success" data-bs-toggle="modal" data-bs-target="#run-automation-modal">
    Run Automation
  </button>

  <button type="button" class="btn btn-danger" data-bs-toggle="modal" data-bs-target="#delete-template-modal">
    <i class="bi bi-trash"></i> Delete
  </button>
<% end %>

<%= content_for :nav_tabs do %>
  <ul class="nav nav-tabs">
    <li class="nav-item">
      <a class="nav-link active" id="details-tab" data-bs-toggle="tab" href="#details" role="tab">Details</a>
    </li>
    <li class="nav-item">
      <a class="nav-link" id="history-tab" data-bs-toggle="tab" href="#history" role="tab">
        History (<%= automation_template.automations.count %>)
      </a>
    </li>
    <li class="nav-item">
      <a class="nav-link" id="webhook-tab" data-bs-toggle="tab" href="#webhook" role="tab">Webhook</a>
    </li>
    <li class="nav-item">
      <a class="nav-link" id="schedules-tab" data-bs-toggle="tab" href="#schedules" role="tab">
        Schedules (<%= automation_template.schedules&.count %>)
      </a>
    </li>
  </ul>
<% end %>

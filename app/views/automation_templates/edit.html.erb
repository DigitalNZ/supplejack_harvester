<%= content_for(:title) { 'Edit Automation Template' } %>
<% breadcrumb :edit_automation_template, @automation_template %>

<% page_heading 'Edit Automation Template' %>

<% page_actions do %>
  <%= link_to 'Cancel', automation_templates_path, class: 'btn btn-outline-secondary' %>

  <button type="submit" class="btn btn-primary" data-form="js-automation-template-form">
    Update
  </button>
<% end %>

<div class="card">
  <div class="card-body">
    <%= render 'form', automation_template: @automation_template %>
  </div>
</div>

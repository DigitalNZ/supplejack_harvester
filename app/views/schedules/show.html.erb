<%= content_for(:title) { 'Edit Schedule' } %>
<% breadcrumb :schedule, @schedule %>

<% page_heading @schedule.subject.name_in_database %>

<% page_actions do %>
  <button type="submit" class="btn btn-primary" data-form="js-schedule-form">
    Update
  </button>

  <%= link_to 'Cancel', schedules_path, class: 'btn btn-outline-secondary' %>
<% end %>

<div class='mb-4'></div>

<%= render 'form' %>

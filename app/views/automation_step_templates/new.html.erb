<%= content_for(:title) { 'New Automation Step' } %>
<% breadcrumb :new_automation_step, @automation_template %>

<% page_heading 'New Step' %>

<% page_actions do %>
  <%= link_to 'Cancel', automation_template_path(@automation_template), class: 'btn btn-outline-secondary' %>

  <button type="submit" class="btn btn-primary" data-form="js-automation-step-template-form">
    Create step
  </button>
<% end %>

<div class="card">
  <div class="card-body">
    <%= render 'form', automation_step_template: @automation_step_template %>
  </div>
</div>

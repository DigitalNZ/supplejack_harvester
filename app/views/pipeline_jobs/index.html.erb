<%= content_for(:title) { @pipeline.name_in_database } %>
<% breadcrumb :pipeline, @pipeline %>

<% pipeline_heading @pipeline %>

<% pipeline_tabs @pipeline, active: :jobs %>

<%= render 'jobs_table',
           jobs: @pipeline_jobs,
           total: @pipeline.pipeline_jobs.count,
           path: pipeline_pipeline_jobs_path(@pipeline),
           pipeline_scoped: true %>

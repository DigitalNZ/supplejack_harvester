<%= content_for(:title) { @pipeline.name_in_database } %>
<% breadcrumb :pipeline, @pipeline %>

<%= content_for :heading do %>
  <h1><%= @pipeline.name %></h1>
  <%= render 'shared/description', description: @pipeline.description %>
<% end %>

<%= content_for :nav_tabs do %>
  <%= render 'pipelines/tabs', pipeline: @pipeline, active: :jobs %>
<% end %>

<%= render 'jobs_table',
           jobs: @pipeline_jobs,
           total: @pipeline.pipeline_jobs.count,
           path: pipeline_pipeline_jobs_path(@pipeline),
           pipeline_scoped: true %>

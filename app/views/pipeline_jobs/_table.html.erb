<div id="jobs-table">
  <div class="card">
    <div class="table-responsive">
      <table class="table table-borderless table--jobs">
        <thead>
          <tr class='table-primary'>
            <%# The first column carries the destination and who ran the job under the
                pipeline's name. On a pipeline's own jobs there is no name to put above
                them, and the destination is what the column then leads with. %>
            <th scope="col"><%= show_pipeline_col ? 'Pipeline' : 'Destination' %></th>
            <th scope="col">Job</th>
            <th scope="col">Status</th>
            <th scope="col">Time started</th>
            <th scope="col" class="text-end">Duration</th>
            <th scope="col" class="text-end">Pages</th>
            <th scope="col" class="text-end">Transform</th>
            <th scope="col" class="text-end">Load</th>
            <th scope="col" class="text-end">Reject</th>
            <th scope="col" class="text-end">Delete</th>
          </tr>
        </thead>
        <tbody>
          <% total_jobs = jobs.size %>
          <% jobs.each.with_index(1) do |job, job_idx| %>
            <% job.harvest_definitions_to_run.zip(job.harvest_reports).each_with_index do |(definition_id, report), row_index| %>

              <% harvest_definition = HarvestDefinition.where(id: definition_id) %>
              <% next if harvest_definition.blank? %>

              <%= render 'pipeline_jobs/job_row',
                         job: job,
                         report: report,
                         harvest_definition: harvest_definition.first,
                         show_pipeline_col: show_pipeline_col,
                         row_index: %>
            <% end %>
            <% if job_idx != total_jobs %>
              <tr class='table__divider'>
                <td colspan='10'><hr></td>
              </tr>
            <% end %>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<% extraction_job_id = report&.harvest_job&.extraction_job_id || job.extraction_job_id %>

<tr>
  <%# Where the job wrote and who ran it sit under the pipeline's name rather than in
      columns of their own - they belong to the job rather than to any one of its rows,
      which is why all three are drawn on the first row of a job only. %>
  <td>
    <% if row_index.zero? %>
      <% if show_pipeline_col %>
        <%= link_to job.pipeline.name, job.pipeline, class: 'fw-semibold' %>
      <% end %>

      <div class="small text-muted"><%= job_source_line(job) %></div>
    <% end %>
  </td>
  <td>
    <% if extraction_job_id.blank? %>
      <%= harvest_definition.name %>
    <% else %>
      <% name = report&.harvest_job&.name || harvest_definition.name %>
      <%= link_to name, pipeline_pipeline_job_path(job.pipeline.id, job.id) %>
    <% end %>
  </td>
  <td>
    <%# The status is an icon and the word rather than a filled badge, so the count of
        errors beside it is the only thing in the column drawn as one. %>
    <span class="d-inline-flex align-items-center gap-2">
      <%= job_status_with_icon(report, job) %>
      <% if report&.harvest_job.present? %>
        <% error_count = JobError.count_for_harvest_job(report.harvest_job) %>
        <% if error_count.positive? %>
          <%= link_to error_count,
                      pipeline_pipeline_job_harvest_job_errors_path(job.pipeline, job, report.harvest_job),
                      class: 'badge text-decoration-none bg-danger',
                      title: 'View harvest job errors' %>
        <% end %>
      <% end %>
    </span>
  </td>
  <td><%= job_started_and_duration(report, job) %></td>
  <td class="text-end">
    <% if extraction_job_id.present? %>
      <%= link_to number_to_delimited(report&.pages_extracted) || '',
                  pipeline_harvest_definition_extraction_definition_extraction_job_path(
                    job.pipeline.id,
                    harvest_definition.id,
                    harvest_definition.extraction_definition.id,
                    extraction_job_id
                  ) %>
    <% end %>
  </td>
  <td class="text-end"><%= number_to_delimited(report&.records_transformed) %></td>
  <td class="text-end"><%= number_to_delimited(report&.records_loaded) %></td>
  <td class="text-end"><%= number_to_delimited(report&.records_rejected) %></td>
  <td class="text-end"><%= number_to_delimited(report&.records_deleted) %></td>
</tr>

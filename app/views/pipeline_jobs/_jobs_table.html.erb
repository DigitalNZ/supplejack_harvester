<%# The jobs list, filters and all. Both the global list and one pipeline's render this,
    and pipeline_scoped is which: it decides the columns a row carries, the heading over
    them, and whether the tags of the pipeline are anything to filter by. Each also passes
    the path of the list it is, so filtering stays on the page it was done from rather
    than sending a pipeline's jobs off to the global list to be narrowed again. %>
<% all_tags = Tag.ordered.to_a %>
<% summary = list_summary(jobs, total, 'job') %>

<%= render layout: 'shared/filter_bar', locals: { path: } do %>
  <%# Submitted on change by js/SubmittingSelect, the way every other list's selects are,
      rather than by an onchange of their own. %>
  <% klass = 'form-select w-auto' %>
  <% submits = { 'data-submitting-select': true } %>

  <%# Tags belong to pipelines, so filtering by them sorts one pipeline's jobs into all
      of them or none: there is nothing to narrow within a single pipeline. %>
  <% unless pipeline_scoped %>
    <%= render 'shared/tag_filter', tags: all_tags, counts: Tag.job_counts,
                                    heading: 'Filter by pipeline tag', path: %>

    <div class="vr"></div>
  <% end %>

  <%# No labels beside these: each one's options say what it filters, and the select
      carries that as its accessible name. %>
  <%= select_tag :run_by, options_for_select(user_opts, params[:run_by]),
                 class: klass, aria: { label: 'Last run by' }, **submits %>

  <%= select_tag :status, options_for_select(status_opts, params[:status]),
                 class: klass, aria: { label: 'Status' }, **submits %>

  <%= select_tag :destination, options_for_select(dest_opts, params[:destination]),
                 class: klass, aria: { label: 'Destination' }, **submits %>
<% end %>

<%# The summary carries the count of the list either way, and the tags it is filtered by
    when there are any - which on a pipeline's jobs only a hand-written query could set,
    and then it is the way to clear it again. %>
<%= render 'shared/filter_summary', tags: all_tags, path:, summary: %>

<% if jobs.present? %>
  <%= render partial: 'pipeline_jobs/table',
             locals: { jobs: jobs, pipeline_scoped: pipeline_scoped } %>

  <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 my-4">
    <span class="small text-body-secondary"><%= page_summary(jobs, 'job') %></span>
    <%= paginate jobs %>
  </div>
<% elsif tag_filter_slugs.any? %>
  <div class="alert alert-light border text-center">
    No jobs belong to a pipeline carrying all of those tags.
    <%= link_to 'Clear the tag filter', tag_filter_url(path, []) %>
  </div>
<% end %>

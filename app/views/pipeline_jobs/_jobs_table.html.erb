<% all_tags = Tag.ordered.to_a %>
<% summary = list_summary(jobs, total, 'job') %>

<%= form_with url: jobs_path, method: :get, html: { id: 'filters-form', class: 'card bg-light mb-3' } do %>
  <div class="card-body p-2 d-flex flex-wrap align-items-center gap-2">
    <% submit = 'this.form.requestSubmit()' %>
    <% klass = 'form-select w-auto' %>
    <%= hidden_field_tag :pipeline_id, params[:pipeline_id] %>

    <%= render 'shared/tag_filter', tags: all_tags, counts: Tag.job_counts,
                                    heading: 'Filter by pipeline tag', path: jobs_path %>

    <div class="vr"></div>

    <%# No labels beside these: each one's options say what it filters, and the select
        carries that as its accessible name. %>
    <%= select_tag :run_by, options_for_select(user_opts, params[:run_by]),
                   class: klass, onchange: submit, aria: { label: 'Last run by' } %>

    <%= select_tag :status, options_for_select(status_opts, params[:status]),
                   class: klass, onchange: submit, aria: { label: 'Status' } %>

    <%= select_tag :destination, options_for_select(dest_opts, params[:destination]),
                   class: klass, onchange: submit, aria: { label: 'Destination' } %>
  </div>
<% end %>

<%= render 'shared/filter_summary', tags: all_tags, path: jobs_path, summary: %>

<% if jobs.present? %>
  <%= render partial: 'pipeline_jobs/table',
             locals: { jobs: jobs, show_pipeline_col: show_pipeline_col } %>

  <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 my-4">
    <span class="small text-muted"><%= page_summary(jobs, 'job') %></span>
    <%= paginate jobs %>
  </div>
<% elsif tag_filter_slugs.any? %>
  <div class="alert alert-light border text-center">
    No jobs belong to a pipeline carrying all of those tags.
    <%= link_to 'Clear the tag filter', tag_filter_url(jobs_path, []) %>
  </div>
<% end %>

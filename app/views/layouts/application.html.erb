<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= content_for?(:title) ? "#{yield(:title)} | " : '' %>Harvester</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">

    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= vite_client_tag %>

    <%= vite_javascript_tag 'application' %>
    <%= vite_stylesheet_tag 'application.scss' %>

    <%# favicons %>
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
    <link rel="manifest" href="/site.webmanifest">
    <link rel="mask-icon" href="/safari-pinned-tab.svg" color="#5bbad5">
    <meta name="msapplication-TileColor" content="#da532c">
    <meta name="theme-color" content="#ffffff">
  </head>

  <body>

    <%= render 'shared/nav' %>

    <%# A page fills the header in slots rather than laying itself out: what the page is about on
        the left, what can be done to it on the right, its tabs under both. The arranging is all
        Bootstrap's, so .header holds only the band and the pull that sits the tabs on its edge.

        :header is the older single-slot version, which lays itself out with floats and a
        clearfix. The pages still on it are due the same treatment. %>
    <header class='header'>
      <div class='container'>
        <%= breadcrumbs style: :bootstrap5 %>

        <% if content_for?(:metadata) || content_for?(:actions) %>
          <div class='d-flex align-items-start justify-content-between gap-3'>
            <div><%= yield :metadata %></div>

            <%# Half a rem of padding sets the buttons against the title rather than its ascenders,
                and the gap is what spaces them, so none of them carries a margin of its own. %>
            <% if content_for?(:actions) %>
              <div class='d-flex align-items-start gap-2 pt-2'><%= yield :actions %></div>
            <% end %>
          </div>
        <% end %>

        <% if content_for?(:nav_tabs) %>
          <div class='mt-4'><%= yield :nav_tabs %></div>
        <% end %>

        <%= yield :header %>
      </div>
    </header>

    <div class="container">
      <div class='mt-4'></div>
      <%= yield %>
    </div>

    <%= render 'shared/flash' %>
    <span id='react-modals'></span>
  </body>
</html>

<%= content_for(:title) { "Editing #{@tag.name_in_database}" } %>
<% breadcrumb :edit_tag, @tag %>

<%= content_for :header do %>
  <h1 class="header__title"><%= @tag.name_in_database %></h1>

  <div class="header__actions">
    <%= link_to 'Cancel', tags_path, class: 'btn btn-outline-secondary me-1' %>

    <button type="submit" class="btn btn-primary" data-form="js-tag-form">Update</button>
  </div>

  <div class="clearfix"></div>
<% end %>

<%= vertical_form_with model: @tag, id: 'js-tag-form' do |form| %>
  <div class="card">
    <div class="card-body">
      <div class="row gy-3 align-items-center">
        <div class="col-3">
          <%= form.label :name, 'Name', class: 'form-label' %>
        </div>

        <div class="col-9">
          <%# Any error marks the field, not only one on the name: a rename can fail on the
              slug the name reduces to, which is the same name being typed again. %>
          <%= form.text_field :name, class: { 'form-control': true, 'is-invalid': @tag.errors.any? } %>
          <p class="form-text">
            Renaming a tag relabels it on every pipeline that carries it. Links filtering a
            list by the old name stop matching.
          </p>
        </div>
      </div>
    </div>
  </div>
<% end %>

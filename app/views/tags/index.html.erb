<%= content_for(:title) { 'Tags' } %>
<% breadcrumb :tags %>

<%= content_for :header do %>
  <div class="float-start">
    <h1>Tags</h1>
    <p>
      Every pipeline is tagged from this one set. Renaming a tag relabels it wherever it is
      carried, and deleting it takes it off every pipeline that carries it.
    </p>
  </div>

  <div class="clearfix"></div>
<% end %>

<% if @tags.any? %>
  <div class="card">
    <div class="card-body p-0">
      <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
          <thead class="table-light">
            <tr>
              <th>Tag</th>
              <th>Pipelines</th>
              <th class="text-end">Actions</th>
            </tr>
          </thead>
          <tbody>
            <% @tags.each do |tag| %>
              <% count = @pipeline_counts.fetch(tag.id, 0) %>
              <tr>
                <td><%= tag_badge(tag) %></td>
                <td>
                  <%# The count links to the pipelines carrying the tag, so that what a tag
                      is on can be looked at before it is renamed or deleted. %>
                  <% if count.zero? %>
                    <span class="text-muted">None</span>
                  <% else %>
                    <%= link_to count, pipelines_path(tags: [tag.slug]) %>
                  <% end %>
                </td>
                <td class="text-end">
                  <%= link_to edit_tag_path(tag), class: 'btn btn-outline-primary btn-sm me-1' do %>
                    <i class="bi bi-pencil-square" aria-hidden="true"></i> Edit
                  <% end %>

                  <button type="button" class="btn btn-outline-danger btn-sm"
                          data-bs-toggle="modal" data-bs-target="#delete-modal-<%= tag.id %>">
                    <i class="bi bi-trash" aria-hidden="true"></i> Delete
                  </button>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <%= render 'shared/pagination_below_table', items: @tags %>
<% else %>
  <p>There are currently no tags. They are created as pipelines are tagged, from a pipeline's page.</p>
<% end %>

<%# The confirmation modals sit outside the table rather than in the row each belongs to:
    a dialog is positioned against the viewport, and nesting it inside the scrolling table
    wrapper leaves that at the mercy of the wrapper's overflow. %>
<% @tags.each do |tag| %>
  <% count = @pipeline_counts.fetch(tag.id, 0) %>
  <%= render layout: 'shared/delete_modal',
             locals: { path: tag_path(tag), id: "delete-modal-#{tag.id}", heading_text: 'Delete tag' } do %>
    <p>Are you sure you want to delete the <strong><%= tag.name %></strong> tag?</p>
    <% if count.zero? %>
      <p>No pipeline carries it, so nothing else changes.</p>
    <% else %>
      <p>It will be taken off the <%= pluralize(count, 'pipeline') %> carrying it.</p>
    <% end %>
  <% end %>
<% end %>

<%= content_for(:title) { "Editing #{@destination.name_in_database}" } %>
<% breadcrumb :edit_destination, @destination %>

<%= content_for :heading do %>
  <h1><%= @destination.name_in_database %></h1>
<% end %>

<%= content_for :actions do %>
  <button type="button" class="btn btn-outline-primary" id="js-test-destination-button">
    Test
  </button>

  <button type="submit" class="btn btn-primary" data-form="js-destination-form">
    Update
  </button>
<% end %>

<%= render 'form' %>

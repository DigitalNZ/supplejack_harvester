<% id ||= 'inline-editable-element' %>
<% multiline = local_assigns.fetch(:multiline, false) %>

<% content_classes = class_names({ 'd-none': model.errors.include?(attribute) })
   form_classes = class_names('mb-2', { 'd-none': model.errors.exclude?(attribute) }) %>

<div class='inline-editable-element'>
  <div id="<%= "#{id}-content" %>" class="<%= content_classes %>">
    <span class='d-flex align-items-center'>
      <%= yield %>

      <i
        class="bi bi-pencil-square inline-editable-element__control js-inline-editable-control ms-2"
        data-id="<%= id %>">
      </i>
    </span>
  </div>

  <%= vertical_form_with(model:, url:, class: form_classes, id: "#{id}-form") do |form| %>

    <% if multiline %>
      <%= form.text_area attribute, class: 'form-control inline-editable-element__textarea', rows: 8 %>
    <% else %>
      <div class='float-start'>
        <%= form.text_field attribute, class: 'form-control w-auto' %>
      </div>
    <% end %>

    <%# a textarea puts its buttons on the line below, a single line field alongside it %>
    <%= form.submit 'Save', class: class_names('btn btn-primary', { 'mt-2': multiline, 'ms-2': !multiline }) %>

    <button
      type='button'
      class="<%= class_names('btn btn-outline-secondary ms-2 js-inline-editable-cancel', { 'mt-2': multiline }) %>"
      data-id="<%= id %>">
      Cancel
    </button>
  <% end %>
</div>

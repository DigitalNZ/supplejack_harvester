<%= content_for(:title) { 'Jobs' } %>
<% breadcrumb :jobs %>

<%= content_for(:header) do %>
  <div class='float-start'>
    <h1>Jobs</h1>
    <p>Global view of pipeline jobs</p>
  </div>

  <div class='clearfix'></div>
<% end %>

<%= render 'pipeline_jobs/jobs_table',
           jobs: @pipeline_jobs,
           total: PipelineJob.count,
           path: jobs_path,
           pipeline_scoped: false %>

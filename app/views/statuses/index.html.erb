<%= content_for(:title) { 'Statuses' } %>
<% breadcrumb :statuses %>

<%= content_for :header do %>
  <div class="float-start">
    <h1>Statuses</h1>
    <p>
      Every status a job or an automation can be in, drawn the way it is drawn wherever it
      appears. The list comes from the models, so a status added to either arrives here on its
      own.
    </p>
  </div>

  <div class="clearfix"></div>
<% end %>

<%# Three columns to a row, so the marks line up under each other and the column names read
    down the left. %>
<div class="row">
  <div class="col-lg-9">
    <div class="card">
      <ul class="list-group list-group-flush">
        <% @statuses.each do |status, description| %>
          <li class="list-group-item">
            <div class="row align-items-center">
              <%# What a status is called in the database, and in a status= filter. %>
              <div class="col-3"><code class="small"><%= status %></code></div>

              <div class="col-3"><%= status_with_icon(status) %></div>

              <div class="col-6 small text-muted"><%= description %></div>
            </div>
          </li>
        <% end %>
      </ul>
    </div>
  </div>
</div>

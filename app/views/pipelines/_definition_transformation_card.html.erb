<%# Transformation definition card for a pipeline block (enrichment / pre-processing).
    locals:
      pipeline:         the pipeline
      block_definition: the HarvestDefinition owning the transformation definition %>
<%= render partial: 'pipelines/card',
           locals: {
             pipeline:,
             block_definition:,
             definition: block_definition.transformation_definition,
             edit_path:
               pipeline_harvest_definition_transformation_definition_path(
                 pipeline, block_definition, block_definition.transformation_definition
               ),
             edit_text: definition_edit_text(block_definition.transformation_definition, 'transformation'),
             jobs_path:
               if block_definition.preprocess?
                 pipeline_harvest_definition_preprocess_outputs_path(pipeline, block_definition)
               else
                 ''
               end,
             jobs_text: 'View Transformed Data',
             delete_path:
               pipeline_harvest_definition_transformation_definition_path(
                 pipeline, block_definition, block_definition.transformation_definition
               )
           } %>

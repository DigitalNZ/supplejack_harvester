<%# Load definition card for a pipeline block.
    locals:
      pipeline:         the pipeline
      block_definition: the HarvestDefinition owning the load definition %>
<%= render partial: 'pipelines/card',
           locals: {
             pipeline:,
             block_definition:,
             definition: block_definition.load_definition,
             edit_path:
               pipeline_harvest_definition_load_definition_path(
                 pipeline, block_definition, block_definition.load_definition
               ),
             edit_text: definition_edit_text(block_definition.load_definition, 'load'),
             delete_path:
               pipeline_harvest_definition_load_definition_path(
                 pipeline, block_definition, block_definition.load_definition
               )
           } %>

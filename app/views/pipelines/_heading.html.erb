<%# What the pipeline is, on every page that is one of its tabs: its name, its description
    and its tags, each edited where it is shown. Rendered through pipeline_heading so the
    four tabs cannot drift into four different answers to which pipeline you are looking at.
    locals:
      pipeline: the pipeline every one of those tabs belongs to %>
<%= render layout: 'shared/inline_editable_element', locals:
  {
    id: 'pipeline-name',
    model: pipeline,
    url: pipeline_path(pipeline),
    attribute: :name
  } do %>
  <h1 class='mb-1'><%= pipeline.name %></h1>
<% end %>

<%= render 'shared/description_editor', model: pipeline, url: pipeline_path(pipeline) %>

<%= render 'pipelines/tags', pipeline: %>

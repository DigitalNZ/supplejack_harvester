<%# The tabs across a pipeline's four pages. Rendered through the pipeline_tabs helper,
    which is what puts them in the header. %>
<% tabs = [
     [:pipeline, 'Pipeline', pipeline_path(pipeline)],
     [:schedules, "Schedules (#{pipeline.schedules.count})", pipeline_schedules_path(pipeline)],
     [:jobs, 'Jobs', pipeline_pipeline_jobs_path(pipeline)],
     [:automation_templates, "Automation Templates (#{pipeline.automation_templates.count})",
      pipeline_automation_templates_path(pipeline)]
   ] %>

<ul class="nav nav-tabs">
  <% tabs.each do |name, label, path| %>
    <li class='nav-item'>
      <%= link_to label, path, class: class_names('nav-link', active: name == active) %>
    </li>
  <% end %>
</ul>

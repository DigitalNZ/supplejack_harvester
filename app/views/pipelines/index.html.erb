<%= content_for(:title) { 'Pipelines' } %>
<% breadcrumb :pipelines %>

<%= content_for :header do %>
  <h1 class="header__title">Pipelines</h1>

  <div class="header__actions">
    <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#create-modal">
        + Create new pipeline
    </button>
  </div>

  <div class="clearfix"></div>

  <div class='mt-4'></div>
  <ul class="nav nav-tabs">

    <li class='nav-item'>
      <%= link_to 'All', pipelines_path, class: "nav-link #{'active' if params['status'].nil?}" %>
    </li>

    <li class='nav-item'>
      <%= link_to 'Queued', pipelines_path(status: 'queued'),
                  class: "nav-link #{'active' if params['status'] == 'queued'}" %>
    </li>

    <li class='nav-item'>
      <%= link_to 'Running', pipelines_path(status: 'running'),
                  class: "nav-link #{'active' if params['status'] == 'running'}" %>
    </li>
  </ul>
<% end %>

<% if params['status'].nil? %>
  <% all_tags = Tag.ordered.to_a %>
  <% summary = list_summary(@pipelines, Pipeline.count, 'pipeline') %>

  <%= render layout: 'shared/filter_bar', locals: { path: pipelines_path } do |form| %>
    <%= render 'shared/search_field', form:,
                                      placeholder: 'Search by name, description, source_id, last edited by' %>

    <button class="btn btn-primary" type="submit">Search</button>

    <div class="vr"></div>

    <%= render 'shared/tag_filter', tags: all_tags, counts: Tag.pipeline_counts,
                                    heading: 'Filter by tag', path: pipelines_path %>

    <%# No labels beside these: each one says what it filters, and the select carries
        that as its accessible name. %>
    <%= form.select(
          :format,
          [['All formats', '']] + ExtractionDefinition::FORMATS.map { |format| [format, format] },
          { selected: params[:format].in?([nil, '', 'All formats']) ? 'All formats' : params[:format] },
          class: 'form-select w-auto', 'aria-label': 'Format', 'data-submitting-select': true
        ) %>

    <%= form.select(
          :sort_by,
          [['Sort by: Last Edited', 'updated_at'], ['Sort by: Alphabetical', 'name']],
          { selected: @sort_by.keys.first },
          class: 'form-select w-auto', 'aria-label': 'Sort by', 'data-submitting-select': true
        ) %>
  <% end %>

  <%= render 'shared/filter_summary', tags: all_tags, path: pipelines_path, summary: %>
<% end %>

<% if @pipelines.empty? && tag_filter_slugs.any? %>
  <div class="alert alert-light border text-center">
    No pipelines carry all of those tags.
    <%= link_to 'Clear the tag filter', tag_filter_url(pipelines_path, []) %>
  </div>
<% end %>

<%- @pipelines.each do |pipeline| %>
  <%= link_to pipeline, class: 'card card--clickable mb-3' do %>
    <div class="card-body">
      <div class="d-flex align-items-center flex-wrap gap-2 mb-1">
        <h2 class="card-title mb-0"><%= pipeline.name %></h2>

        <% pipeline.tags.sort_by(&:name).each do |tag| %>
          <%= tag_label(tag) %>
        <% end %>
      </div>
      <h3 class="card-subtitle mt-0">
        <%= last_edited_by(pipeline) %>
      </h3>
      <div>
        <span class="badge bg-light text-dark">
          <%= pipeline.harvest_definitions.harvest.count %> Harvest
        </span>
        <span class="badge bg-light text-dark">
          <%= pipeline.harvest_definitions.enrichment.count %> Enrichments
        </span>

        <% if pipeline.schedules.any? %>
          <span class="badge bg-primary">
            Scheduled
          </span>
        <% end %>
      </div>
    </div>
  <% end %>
<%- end %>

<% if params['status'].nil? && @pipelines.any? %>
  <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 my-4">
    <span class="small text-body-secondary"><%= page_summary(@pipelines, 'pipeline') %></span>
    <%= paginate @pipelines %>
  </div>
<% end %>

<%= render layout: 'shared/create_modal',
           locals: { modal_heading: 'Create new pipeline', button_text: 'Create pipeline' } do %>
  <%= vertical_form_with model: @pipeline do |form| %>

    <div class='row gy-3 align-items-center'>
      <div class="col-4">
        <%= form.label :name, 'Pipeline Name', class: 'form-label' %>
      </div>
      <div class='col-8'>
        <%= form.text_field :name, class: { 'form-control': true, 'is-invalid': @pipeline.errors[:name].any? } %>
      </div>

      <div class="col-4">
        <%= form.label :description, 'Pipeline Description', class: 'form-label' %>
      </div>
      <div class='col-8'>
        <%= form.text_area :description,
                           class: { 'form-control': true, 'is-invalid': @pipeline.errors[:description].any? } %>
      </div>
    </div>

    <div class='d-grid mt-4'>
      <button type="submit" class="btn btn-primary">Create pipeline</button>
    </div>
  <% end %>
<% end %>
